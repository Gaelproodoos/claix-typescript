{
  "name": "claix-ai",
  "version": "1.2.0",
  "description": "Official TypeScript SDK for Claix: safe database access for AI agents. Retrieve reads, Guard checks INSERT/UPDATE/DELETE, and Ingest turns documents into JSON.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./langchain": {
      "types": "./dist/integrations/langchain.d.ts",
      "import": "./dist/integrations/langchain.js"
    },
    "./llamaindex": {
      "types": "./dist/integrations/llamaindex.d.ts",
      "import": "./dist/integrations/llamaindex.js"
    },
    "./crewai": {
      "types": "./dist/integrations/crewai.d.ts",
      "import": "./dist/integrations/crewai.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "claix",
    "database-security",
    "sql-guardrails",
    "text-to-sql",
    "postgres",
    "mysql",
    "mcp",
    "document-intelligence",
    "langchain",
    "crewai",
    "llamaindex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaelproodoos/claix-typescript.git"
  },
  "homepage": "https://www.claix.dev/documentation/sdks/typescript",
  "bugs": {
    "url": "https://github.com/Gaelproodoos/claix-typescript/issues"
  },
  "author": {
    "name": "Claix",
    "email": "info@claix.dev"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@crewai-ts/core": ">=0.2.6",
    "@langchain/core": ">=0.3.0",
    "llamaindex": ">=0.8.0",
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "@crewai-ts/core": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "llamaindex": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
